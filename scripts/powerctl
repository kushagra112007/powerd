#!/bin/sh
STATE_DIR="/run/powerd"
MODE_FILE="$STATE_DIR/mode"
WATTS_FILE="$STATE_DIR/watts"

set_mode() {
    mkdir -p "$STATE_DIR"
    echo "$1" > "$MODE_FILE"
    chmod 0644 "$MODE_FILE" 2>/dev/null || true
    echo "[powerctl] Mode switched to: $1"
}

get_power_watts() {
    if [ -s "$WATTS_FILE" ]; then
        cat "$WATTS_FILE"
        return
    fi
    for f in /sys/class/hwmon/hwmon*/power1_input; do
        if [ -f "$f" ]; then
            UW=$(cat "$f" 2>/dev/null || echo 0)
            if [ "$UW" -gt 0 ] 2>/dev/null; then
                W_WHOLE=$((UW / 1000000))
                W_FRAC=$(((UW % 1000000) / 10000))
                [ "$W_FRAC" -lt 10 ] && W_FRAC="0$W_FRAC"
                echo "${W_WHOLE}.${W_FRAC}"
                return
            fi
        fi
    done
    for f in /sys/class/powercap/*/energy_uj /sys/class/powercap/*/*/energy_uj; do
        if [ -f "$f" ]; then
            E1=$(cat "$f" 2>/dev/null || echo 0)
            sleep 1
            E2=$(cat "$f" 2>/dev/null || echo 0)
            if [ "$E1" -gt 0 ] 2>/dev/null && [ "$E2" -ge "$E1" ] 2>/dev/null; then
                DELTA=$((E2 - E1))
                W_WHOLE=$((DELTA / 1000000))
                W_FRAC=$(((DELTA % 1000000) / 10000))
                [ "$W_FRAC" -lt 10 ] && W_FRAC="0$W_FRAC"
                echo "${W_WHOLE}.${W_FRAC}"
                return
            fi
        fi
    done
    echo "0.00"
}

show_status() {
    CURRENT="balanced"
    [ -s "$MODE_FILE" ] && CURRENT=$(cat "$MODE_FILE")
    ONLINE=$(cat /sys/devices/system/cpu/online 2>/dev/null)
    WATTS=$(get_power_watts)
    echo "=========================================="
    echo "       POWERD LOW-LEVEL CONTROLLER        "
    echo "=========================================="
    echo " Active Mode  : $CURRENT"
    echo " Online Cores : $ONLINE"
    echo " Package Draw : ${WATTS} W"
    echo "=========================================="
}

usage() {
    echo "Usage: powerctl {low-power|balanced|performance|status}"
    echo "Aliases: low, powersave, eco | bal | perf"
}

case "$1" in
    low-power|low|powersave|eco) set_mode "low-power" ;;
    balanced|bal)                set_mode "balanced" ;;
    performance|perf)            set_mode "performance" ;;
    status|"")                   show_status ;;
    -h|--help|help)              usage ;;
    *)
        echo "[powerctl] Unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
esac
